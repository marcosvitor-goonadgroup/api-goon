# =============================================================================
# api-goon - variaveis de ambiente
# Copie para .env (local) ou cadastre em Vercel > Project > Settings > Env Vars
# =============================================================================

# --- Aplicacao -----------------------------------------------------------
NODE_ENV=development
PORT=3000
# Prefixo global das rotas (ex.: /api/v1/search)
API_PREFIX=api
# Versao default da API (versionamento por URI)
API_VERSION=1

# --- Documentacao --------------------------------------------------------
# Habilita /docs (Scalar) e /docs/swagger (Swagger UI). Desligue em producao se a API for privada.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Seguranca -----------------------------------------------------------
# Lista separada por virgula. Use * para liberar geral (apenas em dev).
CORS_ORIGINS=*
# Chaves de API aceitas, separadas por virgula. Vazio = autenticacao desligada.
# Ex.: API_KEYS=chave-do-parceiro-a,chave-do-parceiro-b
API_KEYS=
# Nome do header que carrega a chave
API_KEY_HEADER=x-api-key

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Janela em milissegundos
RATE_LIMIT_WINDOW_MS=60000
# Requisicoes permitidas por janela, por cliente
RATE_LIMIT_MAX=120

# --- HTTP / resiliencia das integracoes ----------------------------------
# Timeout padrao por chamada externa (ms)
HTTP_TIMEOUT_MS=8000
# Tentativas extras apos a primeira falha
HTTP_MAX_RETRIES=2
# Atraso base do backoff exponencial (ms)
HTTP_RETRY_BASE_DELAY_MS=250
# Falhas consecutivas para abrir o circuito de um conector
CIRCUIT_BREAKER_THRESHOLD=5
# Tempo que o circuito fica aberto antes de testar novamente (ms)
CIRCUIT_BREAKER_RESET_MS=30000

# --- Cache ---------------------------------------------------------------
CACHE_ENABLED=true
# TTL padrao das respostas de integracao (ms)
CACHE_TTL_MS=60000
CACHE_MAX_ITEMS=500

# --- Busca federada ------------------------------------------------------
# Teto de tempo para o fan-out entre conectores (ms)
SEARCH_TIMEOUT_MS=10000

# --- Logs ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# =============================================================================
# Conectores (cada integracao declara as suas)
# =============================================================================

# UOL Ads - campanhas e relatorios de midia
# A chave vai no header Authorization. Sem UOL_ADS_KEY o conector fica
# desabilitado automaticamente (evita uma sequencia de 401 contra a origem).
UOL_ADS_ENABLED=true
UOL_ADS_BASE_URL=https://api.ads.uol.com.br
UOL_ADS_KEY=
# TTL do cache de campanhas (ms). Relatorios usam o dobro deste valor.
UOL_ADS_CACHE_TTL_MS=300000

# Exemplo de conector REST generico protegido por token
# GENERIC_REST_ENABLED=false
# GENERIC_REST_BASE_URL=https://api.parceiro.com/v1
# GENERIC_REST_TOKEN=
